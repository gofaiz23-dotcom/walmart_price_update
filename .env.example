# Same Walmart keys as marketplacesheet_use_template/.env.
# The real values live in .env (gitignored). The hub .env is still used if a key is missing here.

WALMART_CLIENT_ID=
WALMART_CLIENT_SECRET=
WALMART_TOKEN_API=https://marketplace.walmartapis.com/v3/token
WALMART_ITEMS_API=https://marketplace.walmartapis.com/v3/items
WALMART_ORDERS_API=https://marketplace.walmartapis.com/v3/orders
WALMART_INVENTORY_API=https://marketplace.walmartapis.com/v3/inventory
WALMART_FEEDS_API=https://marketplace.walmartapis.com/v3/feeds
WALMART_PRICING_REDUCTION_PERCENT=
MARKETPLACE_NAME=WALMART

# Set to require this header on fetch and price-update calls: x-price-admin-token
# WALMART_PRICE_ADMIN_TOKEN=

# auto | report | items
# WALMART_PRICE_FETCH_MODE=auto
# WALMART_ITEMS_PAGE_SIZE=1000
# WALMART_ITEMS_PAGE_DELAY_MS=2000
# WALMART_PRICE_PUT_DELAY_MS=250
# WALMART_PRICE_VERIFY=true
# WALMART_PRICE_DATA_DIR=
